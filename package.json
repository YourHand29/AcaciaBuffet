{
  "name": "acacia-buffet",
  "private": true,
  "version": "0.1.0",
  "description": "A local, fast, configurable front-end for Canvas LMS",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:server": "pnpm --filter @acacia/server dev",
    "dev:web": "pnpm --filter @acacia/web dev",
    "sync": "pnpm --filter @acacia/server sync",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
