# Your institution's Canvas URL (no trailing slash, no /api/v1)
CANVAS_BASE_URL=https://canvas.yourschool.edu

# Personal access token: Canvas → Account → Settings → New Access Token
CANVAS_TOKEN=

# Where the SQLite database and downloaded files live
DATA_DIR=./data

# Where per-course config files live
CONFIG_DIR=./config

# API server port
PORT=4800

# Background sync interval in minutes (0 disables the scheduler)
SYNC_INTERVAL_MINUTES=15
